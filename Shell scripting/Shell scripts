Script 37: Devops Backup script

#!/bin/bash
source="/mnt/demo.txt"
dest="backups"
log="/var/log/backup.log"

timestamp=$(date +%y-%m-%d_%H-%M-%S)

mkdir -p $dest

tar -czf $dest/backup_${timestamp}.tar.gz $source

if [ $? -eq 0 ]
then 
    echo "$timestamp: Backup successful" >> $log
    else
    echo "$timestamp: Backup failed" >> $log
fi

