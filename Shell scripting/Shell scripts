script 36: server management tool

#!/bin/bash
PS3="Select an Option:"
select option in "check disk" "check memory" "check CPU" "exit"
do
    case $option in
         check disk) 
                   df -h
                  ;;
         check memory)
                   free -h
                   ;;
         check CPU)
                   uptime 
                  ;;
         exit)
              echo "Exiting server mangement tool"
              break
              ;;
          *)
             echo "Invalid Input"
             ;;
       esac
done

#PS3 is a special bash variable used with select statment
#it defins the msg that bash displays when it asks the user to select an option

