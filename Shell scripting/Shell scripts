Script 38: Service health check

#!/bin/bash
service_name=$1
log="/var/log/service_health.log"

check_service()
{
    if systemctl is-active $service_name
    then
        echo "$(date): $service_name is running" >> $log
    else
        echo "$(date): $service_name is not running. RESTARTING..." >> $log
        systemctl restart $service_name

        if [ $? -eq 0 ]
        then
            echo "$(date): $service_name restarted successfully" >> $log
        else
            echo "$(date): Failed to restart $service_name" >> $log
        fi
    fi
}

if [ -z $service_name ]
then
    echo "Please provide service name"
    else
    check_service
    echo "Service status is saved in log file"
fi
